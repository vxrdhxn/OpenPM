# ============================================================
# OpenPM Environment Variables
# ------------------------------------------------------------
# This is a template file. Copy it to .env and fill in real
# values. NEVER COMMIT .env TO VERSION CONTROL.
# ============================================================

# ──────────────── CORE APPLICATION ────────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ──────────────── DATABASE ────────────────
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
POSTGRES_USER=openpm
POSTGRES_PASSWORD=openpm
POSTGRES_DB=openpm
DATABASE_URL=postgresql://openpm:openpm@localhost:5432/openpm

# ──────────────── CACHE & QUEUE ────────────────
# Redis connection string
# Format: redis://:[password]@[host]:[port]
REDIS_PASSWORD=openpm
REDIS_URL=redis://:openpm@localhost:6379

# ──────────────── AUTHENTICATION ────────────────
# Secret used to sign JWTs. Must be at least 32 characters.
# In production, generate securely: `openssl rand -hex 32`
JWT_SECRET=super_secret_development_key_change_me_in_prod_123

# ──────────────── SECURITY ────────────────
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:3001

# ──────────────── EMAIL DELIVERY ────────────────
# Resend API Key for email delivery. If blank, worker falls back to mock console logs.
RESEND_API_KEY=
# The "From" address for system notifications
EMAIL_FROM_ADDRESS=notifications@openpm.local

# ──────────────── ATTACHMENT STORAGE (S3-compatible) ────────────────
# Task attachments are uploaded by the browser straight to object storage via presigned URLs.
# Works with AWS S3, MinIO, Cloudflare R2, etc. If any of BUCKET / ACCESS_KEY_ID /
# SECRET_ACCESS_KEY is unset, attachments are disabled (the API returns 503 for them).
#
# For AWS S3: set only S3_REGION, S3_BUCKET and the credentials.
# For MinIO / other: also set S3_ENDPOINT and S3_FORCE_PATH_STYLE=true.
S3_ENDPOINT=
# Address the BROWSER can reach (used in presigned URLs). Defaults to S3_ENDPOINT. Needed when
# the API reaches storage on an internal hostname (e.g. http://minio:9000) but browsers use
# another (e.g. http://localhost:9000).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Maximum size of a single attachment in bytes (default 10 MiB).
ATTACHMENT_MAX_BYTES=10485760
# The bucket must allow browser PUT/GET from your frontend origin (CORS), see docs.
