{
  "name": "openpm",
  "version": "0.1.0",
  "private": true,
  "description": "OpenPM \u2014 Self-hostable project management on Kubernetes",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/api",
    "apps/worker",
    "apps/frontend"
  ],
  "scripts": {
    "migrate": "npm run migrate --workspace=apps/api",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/worker && npm run build --workspace=apps/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present && npm run test:repo",
    "test:repo": "vitest run --config vitest.repo.config.mts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
