{
  "name": "@openpm/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-migrations.js",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status",
    "migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/websocket": "^11.3.7",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.5",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.8",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pino": "^9.14.0",
    "prom-client": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "globals": "^14.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
