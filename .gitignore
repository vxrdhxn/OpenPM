# ============================================================
# OpenPM .gitignore — PUBLIC REPO: treat every line as a firewall
# ============================================================

# ──────────────── SECRETS & CREDENTIALS ────────────────
# Environment files — NEVER commit real secrets
.env
.env.*
!.env.example
# ^ Only .env.example (with placeholder values) is allowed

# Keys, certificates, and tokens
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.secret
*.secrets
**/secrets/
**/credentials/

# Cloud provider credentials
.aws/
.gcloud/
.azure/
gcp-key*.json
serviceAccountKey*.json
aws-credentials*
kubeconfig*
!helm/  # helm dir is fine, but no real kubeconfigs

# SSH keys
id_rsa
id_ed25519
*.pub
authorized_keys

# Token / API key files
.token
.tokens
*.token
api_key*
apikey*

# Helm value overrides with real secrets
values.local.yaml
values.secret*.yaml
**/values.override.yaml

# ──────────────── DEPENDENCIES ────────────────
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ──────────────── BUILD OUTPUT ────────────────
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# ──────────────── DOCKER ────────────────
# Local volumes (never commit data)
postgres_data/
redis_data/
**/docker-data/

# Docker override (local customizations)
docker-compose.override.yml

# ──────────────── TEST & COVERAGE ────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ──────────────── IDE & EDITORS ────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ──────────────── OS FILES ────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ──────────────── LOGS ────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ──────────────── MISC ────────────────
# Temporary files
tmp/
temp/
*.tmp

# Crash dumps
core.*
hs_err_pid*
